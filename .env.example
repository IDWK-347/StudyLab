# StudyLab 后端环境变量模板
#
# 用法：cp .env.example .env
# ⚠️ .env 已被 .gitignore 忽略。本文档中所有 CHANGE_ME 都必须换成自生成的真实值。
# ⚠️ 本文档与 app/core/config.py 的字段名、docker-compose.yml 的变量名三者必须一致。

# ---------- 应用 ----------
APP_NAME=StudyLab
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- 数据库（阶段 1）----------
# 后端跑在宿主机：      localhost:5433
# 后端跑在 Compose 内： postgres:5432
# 两者不可混用（README 第 11 节）。
DATABASE_URL=postgresql+asyncpg://studylab:CHANGE_ME@localhost:5433/studylab
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# docker-compose.yml 读取此变量来初始化容器。
# ⚠️ 必须与上面 DATABASE_URL 里的密码保持一致，否则应用连不上库。
POSTGRES_PASSWORD=CHANGE_ME

# ---------- 认证（阶段 2）----------
# 只有 access token 需要签名密钥 —— refresh token 是 opaque 随机串，不签名。
# 生成方式：
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 模型服务 Ollama（阶段 4）----------
# 统一走 Ollama 原生 API，不使用 OpenAI 兼容端点，故没有 API Key。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.8
OLLAMA_EMBEDDING_MODEL=bge-m3
# 本机 bge-m3 实测维度。改嵌入模型必须重新向量化全部历史文档。
EMBEDDING_DIMENSION=1024

# ---------- 全文检索（阶段 5）----------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=studylab

# ---------- 对象存储（阶段 3）----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=studylab-documents
MINIO_SECURE=false

# ---------- 缓存与跨域 ----------
# Redis 为可选组件，关闭时不得影响主流程。
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# 携带 Cookie 凭证时不能用 * 通配，须显式列出来源。
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
